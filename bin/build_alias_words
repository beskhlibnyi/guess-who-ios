#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "optparse"
require "tempfile"
require "csv"

options = {
  sample_size: 12
}

OptionParser.new do |parser|
  parser.banner = "Usage: bin/build_alias_words --source mph_ua.db --frequency lemma_counts.tsv --output alias_words.sqlite"
  parser.on("--source PATH", "Path to mph_ua.db") { |value| options[:source] = value }
  parser.on("--frequency PATH", "Optional lemma TSV or UberText CSV(.xz)") { |value| options[:frequency] = value }
  parser.on("--output PATH", "Generated JSON or .sqlite dataset path") { |value| options[:output] = value }
  parser.on("--preview-output PATH", "Optional path for enabled preview words") { |value| options[:preview_output] = value }
  parser.on("--sample-size NUMBER", Integer, "Enabled sample size (default: 12)") { |value| options[:sample_size] = value }
end.parse!

abort "Missing --source PATH" unless options[:source]
abort "Missing --output PATH" unless options[:output]
abort "Source database does not exist: #{options[:source]}" unless File.file?(options[:source])
abort "Frequency file does not exist: #{options[:frequency]}" if options[:frequency] && !File.file?(options[:frequency])

query = <<~SQL
  SELECT
    n.reestr AS source_word,
    n.own AS own,
    n.isdel AS is_deleted,
    n.part AS part_id,
    COALESCE(p.part, '') AS part_code,
    COALESCE(p.com, '') AS part_label,
    COALESCE(g.part_of_speech, '') AS part_of_speech
  FROM nom n
  LEFT JOIN parts p ON p.id = n.part
  LEFT JOIN gr g ON g.id = p.gr_id
  ORDER BY n.nom_old ASC;
SQL

output, status = Open3.capture2("sqlite3", "-readonly", "-json", options[:source], query)
abort "Could not read mph_ua.db" unless status.success?

def normalize_word(value)
  value
    .unicode_normalize(:nfc)
    .strip
    .delete('"')
    .gsub(/[\u2019\u02BC']/, "\u02BC")
    .gsub(/\s+/, " ")
    .downcase
end

def word_shape?(word)
  word.match?(/\A[а-щьюяґєіїʼ-]+(?: [а-щьюяґєіїʼ-]+)*\z/)
end

def part_of_speech(row)
  label = row.fetch("part_of_speech")

  return "noun" if label.include?("іменник")
  return "verb" if label.include?("дієслово")
  return "adjective" if label == "прикметник"
  return "adverb" if row.fetch("part_code") == "присл"

  "other"
end

def abbreviation?(row)
  row.fetch("part_label").include?("абрев") || row.fetch("part_code") == "аб"
end

def proper_name?(row)
  row.fetch("own").to_i != 0
end

def rank(candidate)
  [
    candidate.fetch("enabled") ? 1 : 0,
    candidate.fetch("isProperName") ? 0 : 1,
    candidate.fetch("isPhrase") ? 0 : 1,
    candidate.fetch("partOfSpeech") == "other" ? 0 : 1
  ]
end

def add_frequency!(frequencies, lemma, count_text, part_of_speech: nil)
  count = Integer(count_text, exception: false)
  return false if lemma.nil? || count.nil? || count.negative?

  word = normalize_word(lemma)
  return false if word.empty?

  key = part_of_speech ? [word, part_of_speech] : word
  frequencies[key] += count
  true
end

def load_tsv_frequencies(path)
  frequencies = Hash.new(0)
  skipped_lines = 0

  File.foreach(path, encoding: "UTF-8") do |line|
    next if line.strip.empty? || line.start_with?("#")

    lemma, count_text = line.strip.split("\t", 2)
    skipped_lines += 1 unless add_frequency!(frequencies, lemma, count_text)
  end

  [frequencies, skipped_lines]
end

def load_ubertext_frequencies(path)
  frequencies = Hash.new(0)
  skipped_lines = 0
  reader = lambda do |io|
    CSV.new(io, headers: true).each do |row|
      skipped_lines += 1 unless add_frequency!(
        frequencies,
        row["lemma"],
        row["count"],
        part_of_speech: row["pos"]
      )
    end
  end

  if path.end_with?(".xz")
    Open3.popen2("xzcat", path) do |input, output, thread|
      input.close
      reader.call(output)
      abort "Could not decompress UberText frequency data" unless thread.value.success?
    end
  else
    File.open(path, "r:UTF-8") { |file| reader.call(file) }
  end

  [frequencies, skipped_lines, true]
end

def load_frequencies(path)
  return load_ubertext_frequencies(path) if path.end_with?(".csv", ".csv.xz")

  frequencies, skipped_lines = load_tsv_frequencies(path)
  [frequencies, skipped_lines, false]
end

def universal_part_of_speech(part_of_speech)
  {
    "noun" => "NOUN",
    "verb" => "VERB",
    "adjective" => "ADJ"
  }.fetch(part_of_speech, nil)
end

def assign_frequency_and_difficulty!(candidates, enabled, frequencies, pos_aware, stats)
  candidates.each do |candidate|
    key = if pos_aware
      [candidate.fetch("word"), universal_part_of_speech(candidate.fetch("partOfSpeech"))]
    else
      candidate.fetch("word")
    end
    candidate["frequency"] = frequencies.fetch(key, 0)
  end

  matched = enabled.select { |candidate| candidate.fetch("frequency").positive? }
  stats[:frequency_matched] = matched.length
  stats[:frequency_missing] = enabled.length - matched.length

  maximum_log_frequency = matched.map { |candidate| Math.log10(candidate.fetch("frequency") + 1) }.max || 1.0
  candidates.each do |candidate|
    frequency = candidate.fetch("frequency")
    rarity = if frequency.positive?
      1.0 - (Math.log10(frequency + 1) / maximum_log_frequency)
    else
      1.0
    end
    length = candidate.fetch("word").length
    length_score = [[(length - 3).fdiv(17), 0.0].max, 1.0].min
    candidate["difficulty"] = (1.0 + 4.0 * ((rarity * 0.75) + (length_score * 0.25))).round(3)
  end
end

def write_sqlite(path, candidates)
  File.delete(path) if File.exist?(path)

  Tempfile.create(["alias_words", ".tsv"]) do |file|
    candidates.each do |candidate|
      file.puts [
        candidate.fetch("word"),
        candidate.fetch("partOfSpeech"),
        candidate.fetch("source"),
        candidate.fetch("frequency", 0) || 0,
        candidate.fetch("difficulty", 5.0) || 5.0,
        candidate.fetch("isProperName") ? 1 : 0,
        candidate.fetch("isPhrase") ? 1 : 0,
        candidate.fetch("isAbbreviation") ? 1 : 0,
        candidate.fetch("enabled") ? 1 : 0
      ].join("\t")
    end
    file.flush

    sql = <<~SQL
      PRAGMA journal_mode = OFF;
      PRAGMA synchronous = OFF;
      CREATE TABLE words (
        id INTEGER PRIMARY KEY,
        word TEXT NOT NULL UNIQUE,
        part_of_speech TEXT NOT NULL,
        source TEXT NOT NULL,
        frequency INTEGER NOT NULL,
        difficulty REAL NOT NULL,
        is_proper_name INTEGER NOT NULL,
        is_phrase INTEGER NOT NULL,
        is_abbreviation INTEGER NOT NULL,
        enabled INTEGER NOT NULL,
        revealed INTEGER NOT NULL DEFAULT 0,
        approved INTEGER NOT NULL DEFAULT 0,
        discarded INTEGER NOT NULL DEFAULT 0
      );
      CREATE TABLE words_import (
        word TEXT NOT NULL,
        part_of_speech TEXT NOT NULL,
        source TEXT NOT NULL,
        frequency INTEGER NOT NULL,
        difficulty REAL NOT NULL,
        is_proper_name INTEGER NOT NULL,
        is_phrase INTEGER NOT NULL,
        is_abbreviation INTEGER NOT NULL,
        enabled INTEGER NOT NULL
      );
      .mode tabs
      .import '#{file.path}' words_import
      INSERT INTO words (
        word,
        part_of_speech,
        source,
        frequency,
        difficulty,
        is_proper_name,
        is_phrase,
        is_abbreviation,
        enabled
      )
      SELECT
        word,
        part_of_speech,
        source,
        frequency,
        difficulty,
        is_proper_name,
        is_phrase,
        is_abbreviation,
        enabled
      FROM words_import;
      DROP TABLE words_import;
      CREATE INDEX words_enabled_difficulty ON words(enabled, difficulty);
    SQL
    _, status = Open3.capture2("sqlite3", path, stdin_data: sql)
    abort "Could not write SQLite dataset: #{path}" unless status.success?
  end
end

rows = JSON.parse(output)
stats = Hash.new(0)
candidates_by_word = {}

rows.each do |row|
  stats[:source_rows] += 1
  if row.fetch("is_deleted").to_i != 0
    stats[:deleted_rows] += 1
    next
  end

  word = normalize_word(row.fetch("source_word"))
  unless word_shape?(word)
    stats[:malformed_rows] += 1
    next
  end

  pos = part_of_speech(row)
  candidate = {
    "word" => word,
    "partOfSpeech" => pos,
    "source" => "mph_ua",
    "isProperName" => proper_name?(row),
    "isPhrase" => word.include?(" "),
    "isAbbreviation" => abbreviation?(row)
  }
  candidate["enabled"] = !candidate.fetch("isProperName") &&
    !candidate.fetch("isPhrase") &&
    !candidate.fetch("isAbbreviation") &&
    %w[noun adjective].include?(pos)

  existing = candidates_by_word[word]
  if existing
    stats[:duplicate_normalized_rows] += 1
    candidates_by_word[word] = candidate if (rank(candidate) <=> rank(existing)) == 1
  else
    candidates_by_word[word] = candidate
  end
end

candidates = candidates_by_word.values.sort_by { |candidate| candidate.fetch("word") }
enabled = candidates.select { |candidate| candidate.fetch("enabled") }

stats[:normalized_unique_words] = candidates.length
stats[:excluded_proper_names] = candidates.count { |candidate| candidate.fetch("isProperName") }
stats[:excluded_phrases] = candidates.count { |candidate| candidate.fetch("isPhrase") }
stats[:excluded_abbreviations] = candidates.count { |candidate| candidate.fetch("isAbbreviation") }
stats[:final_playable_words] = enabled.length

if options[:frequency]
  frequencies, skipped_lines, pos_aware = load_frequencies(options[:frequency])
  stats[:frequency_source_entries] = frequencies.length
  stats[:frequency_skipped_lines] = skipped_lines
  assign_frequency_and_difficulty!(candidates, enabled, frequencies, pos_aware, stats)
else
  candidates.each do |candidate|
    candidate["frequency"] = nil
    candidate["difficulty"] = nil
  end
end

dataset = {
  "schemaVersion" => 2,
  "source" => "mphdict mph_ua.db",
  "normalization" => "NFC, lowercase, stress markers removed, apostrophes normalized to U+02BC",
  "frequencyIncluded" => !options[:frequency].nil?,
  "words" => candidates
}

if File.extname(options[:output]) == ".sqlite"
  write_sqlite(options[:output], candidates)
else
  File.write(options[:output], JSON.generate(dataset))
end
if options[:preview_output]
  File.write(options[:preview_output], enabled.map { |candidate| candidate.fetch("word") }.join("\n") + "\n")
end

puts "Source dictionary rows:       #{stats[:source_rows]}"
puts "Deleted source rows:          #{stats[:deleted_rows]}"
puts "Malformed source rows:        #{stats[:malformed_rows]}"
puts "Duplicate normalized rows:    #{stats[:duplicate_normalized_rows]}"
puts "Normalized unique words:      #{stats[:normalized_unique_words]}"
puts "Excluded proper names:        #{stats[:excluded_proper_names]}"
puts "Excluded phrases:             #{stats[:excluded_phrases]}"
puts "Excluded abbreviations:       #{stats[:excluded_abbreviations]}"
puts "Final playable words:         #{stats[:final_playable_words]}"
if options[:frequency]
  puts "Frequency source entries:     #{stats[:frequency_source_entries]}"
  puts "Frequency skipped lines:      #{stats[:frequency_skipped_lines]}"
  puts "Frequency matched:            #{stats[:frequency_matched]}"
  puts "Frequency missing:            #{stats[:frequency_missing]}"
end
puts
puts "Enabled words by part of speech:"
enabled.group_by { |candidate| candidate.fetch("partOfSpeech") }
  .sort_by { |part, _| part }
  .each { |part, words| puts "  #{part}: #{words.length}" }
puts
puts "Deterministic sample:"
enabled.sample([options[:sample_size], enabled.length].min, random: Random.new(20260902))
  .sort_by { |candidate| candidate.fetch("word") }
  .each { |candidate| puts "  #{candidate.fetch("word")} (#{candidate.fetch("partOfSpeech")})" }
